# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Flutterwave payment placeholder.
# For a no-code Flutterwave Payment Link, paste the link here. CampusHub will
# append amount/reference metadata as query params for easier reconciliation.
# For production-grade variable amounts, replace this with a Supabase Edge
# Function that calls Flutterwave Standard and returns data.link.
VITE_FLUTTERWAVE_PAYMENT_LINK_URL="https://flutterwave.com/pay/your-campus-hub-link"
VITE_FLUTTERWAVE_CURRENCY="NGN"
VITE_BACKUP_PAYMENT_DM_URL="https://wa.me/2347074474275"

# Optional error monitoring. Leave empty locally; set in production after
# creating a Sentry project.
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"

# Optional AI assistant endpoint. Use a Supabase Edge Function or backend route;
# never put model API keys in browser env variables.
VITE_AI_ASSISTANT_ENDPOINT=""

# Optional server-side Supabase configuration for CLI/database operations.
# These are not bundled into browser code and should only be used in local
# or trusted backend environments.
SUPABASE_DB_URL="postgresql://user:password@host:port/postgres"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Never expose database connection strings, service-role keys, or Flutterwave
# secrets with a VITE_ prefix. Keep server-only secrets in Supabase Edge
# Function secrets or your backend host environment.
